SELECT
    symbol
    , trade_date
    , open
    , high
    , low
    , close
    , volume
    , high - low AS daily_range
    , open - close AS daily_change
    , CASE
          WHEN open <> 0 THEN ROUND((open - close) / open, 4)
          ELSE 0
      END AS pct_change
    , CASE
          WHEN open < close THEN 'UP'
          WHEN open > close THEN 'DOWN'
          ELSE 'FLAT'
      END AS direction
FROM PROJECT_DB.STAGING.raw_stocks_SHAWA
        );
